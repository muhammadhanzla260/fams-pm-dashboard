# Postgres (Neon / Supabase / RDS)
DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# Jira Cloud
JIRA_BASE_URL=https://fams.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=__atlassian_api_token__
# Comma-separated project keys the reconcile sweep should cover.
# This dashboard targets the FAMS (V5 / IWMP) space = the FM project.
JIRA_PROJECTS=FM

# Extraction scope as a JQL filter (combined with project). Examples:
#   JIRA_SCOPE_JQL=created >= -12w        (rolling 12-week window)
#   JIRA_SCOPE_JQL=fixVersion = 12103     (a specific release)
# If unset, falls back to created >= JIRA_CREATED_WITHIN (default -12w).
JIRA_SCOPE_JQL=created >= -12w
JIRA_CREATED_WITHIN=-12w

# Shared secret Jira appends to the webhook URL (?secret=...) — verified on every POST
WEBHOOK_SECRET=__long_random_string__

# Secret the GitHub Actions cron sends as the x-cron-secret header
CRON_SECRET=__another_long_random_string__
